# ── CardioAI Environment Variables ──────────────────────────────
#
# Copy this file to .env for local dev, or set these vars
# in your Render / Railway dashboard for production.
#

# Point this at your deployed Flask backend (Render, Railway, etc.)
# Leave empty or unset to use Demo Mode.
VITE_API_BASE=https://your-backend.onrender.com/api

# Required on the BACKEND (Flask server) for PDF ECG analysis.
# The backend proxies Claude Vision calls server-side to avoid CORS.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
