# ── CardioAI Environment Variables ──────────────────────────────
#
# Copy this file to .env.local for local dev, or set these vars
# in your Vercel / Netlify dashboard for production.
#
# If VITE_API_BASE is NOT set, the app runs in Demo Mode
# (all predictions are simulated client-side — no backend needed).
#

# Point this at your deployed Flask backend (Render, Railway, etc.)
# Leave empty or unset to use Demo Mode.
VITE_API_BASE=https://your-backend.onrender.com/api
