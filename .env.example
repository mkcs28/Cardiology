# ── CardioAI Environment Variables ──────────────────────────────
#
# Copy this file to .env for local dev:
#   cp .env.example .env
#
# Then start the backend:
#   pip install -r requirements.txt
#   python api.py
#
# And start the frontend:
#   npm install
#   npm run dev
#

# Point this at your running Flask backend.
# For local dev: http://localhost:5000/api
# For production (Render/Railway): https://your-backend.onrender.com/api
VITE_API_BASE=http://localhost:5000/api
